# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key, NOT the anon key

# Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# CORS — must match the URL your frontend runs on
FRONTEND_URL=http://localhost:3000

# Optional — set if Audiveris is not on your system PATH
# AUDIVERIS_PATH=C:\Program Files\Audiveris\Audiveris.exe
