# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Service role bypasses RLS, which backend writes require. Keep it server-side.
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback if the service role key is unset. RLS will block inserts,
# so this is for local poking only, not a substitute.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — console.anthropic.com → API Keys
# Without this the planning graph is skipped and pieces get the deterministic
# fallback plan instead.
ANTHROPIC_API_KEY=

# CORS — must match the URL your frontend runs on
FRONTEND_URL=
# Optional — local dev origin, so localhost and the deployed frontend both work
FRONTEND_DEV_URL=http://localhost:3000

# Optional — Postgres connection string (Supabase → Settings → Database).
# Enables LangGraph checkpointing, so a restart mid-run resumes instead of
# stranding the piece. The graph runs fine without it.
DATABASE_URL=

# Optional — set if Audiveris is not on your system PATH
# AUDIVERIS_PATH=
