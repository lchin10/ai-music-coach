# Frontend needs exactly three variables. All are NEXT_PUBLIC_ because they are
# read in the browser — Next.js only inlines NEXT_PUBLIC_* into the client bundle.
#
# Never put SUPABASE_SERVICE_ROLE_KEY or any LLM API key in this file. The
# frontend never uses them, and the service role key bypasses RLS.

# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The "anon / public" key, NOT the service role key. The NEXT_PUBLIC_ prefix is
# required: without it the browser Supabase client gets undefined and auth fails.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend. http://localhost:8000 for local dev; the Fly URL in Vercel.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
